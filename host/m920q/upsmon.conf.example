# /etc/nut/upsmon.conf on the M920q (root:nut, mode 640). /etc/nut/nut.conf: MODE=netclient
# NUT secondary of the NAS's nut-server; credentials are NUT_MON_USER / NUT_MON_PASSWORD from .env.
MONITOR cyberpower@192.168.0.172 1 <NUT_MON_USER> <NUT_MON_PASSWORD> secondary
MINSUPPLIES 1
SHUTDOWNCMD "/sbin/shutdown -h +0"
POLLFREQ 5
POLLFREQALERT 5
HOSTSYNC 15
DEADTIME 15
FINALDELAY 5
