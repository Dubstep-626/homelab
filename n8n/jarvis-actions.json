      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body || {};\nconst map = {\n  wake_x570:     { url: 'http://control-api:5000/x570/wake',       body: {},                           label: 'Wake the X570 (deus-vult)' },\n  shutdown_x570: { url: 'http://control-api:5000/x570/shutdown',   body: {},                           label: 'Shut down the X570 (deus-vult)' },\n  power_on_t430: { url: 'http://control-api:5000/api/idrac/power', body: { action: 'On' },              label: 'Power on the T430 (pve)' },\n  shutdown_t430: { url: 'http://control-api:5000/api/idrac/power', body: { action: 'GracefulShutdown' }, label: 'Gracefully shut down the T430 (pve)' },\n  lockdown_off:  { url: 'http://jarvis-sentinel:8000/lockdown/off', body: {},                    label: 'Turn OFF lab lockdown' },\n};\nconst m = map[b.action];\nif (!m) throw new Error('Unknown action: ' + b.action);\nreturn [{ json: { ...m, action: b.action, reason: b.reason || '' } }];"
      },
      "name": "Map action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendAndWait",
        "guildId": {
          "__rl": true,
          "value": "1556147688309788692",
          "mode": "id"
        },
        "channelId": {
          "__rl": true,
          "value": "1572176540962259035",
          "mode": "id"
        },
        "message": "={{ '**Jarvis requests approval:** ' + $json.label + ($json.reason ? '\\nReason: ' + $json.reason : '') }}",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Approve",
            "disapproveLabel": "Deny"
          }
        },
        "options": {}
      },
      "name": "Discord: ask approval",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "a1",
              "leftValue": "={{ $json.data && $json.data.approved === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
