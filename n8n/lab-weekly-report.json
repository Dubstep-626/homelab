{
  "name": "Lab - Weekly Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 0"
            }
          ]
        }
      },
      "name": "Sunday 9AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://lab-report:8000/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer PASTE_CONTROL_API_TOKEN_HERE"
            }
          ]
        },
        "options": {
          "timeout": 2400000
        }
      },
      "name": "Run weekly report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "u1",
              "leftValue": "={{ $json.updates_pending === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Updates pending?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendAndWait",
        "guildId": {
          "__rl": true,
          "value": "1556147688309788692",
          "mode": "id"
        },
        "channelId": {
          "__rl": true,
          "value": "1572176540962259035",
          "mode": "id"
        },
        "message": "={{ '**Lab Report requests approval:** apply pending updates, one host at a time (nas → pve → deus-vult → m920q last). No reboots; NUT stays pinned.\\n' + $json.updates_text }}",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Approve",
            "disapproveLabel": "Deny"
          }
        },
        "options": {}
      },
      "name": "Discord: ask approval",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        660,
        -80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "a1",
              "leftValue": "={{ $json.data && $json.data.approved === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://lab-report:8000/apply",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer PASTE_CONTROL_API_TOKEN_HERE"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "name": "Apply updates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -160
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "guildId": {
          "__rl": true,
          "value": "1556147688309788692",
          "mode": "id"
        },
        "channelId": {
          "__rl": true,
          "value": "1572176540962259035",
          "mode": "id"
        },
        "content": "❌ Updates skipped. They'll show again in next week's report.",
        "options": {}
      },
      "name": "Discord: denied",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    }
  ],
  "connections": {
    "Sunday 9AM": {
      "main": [
        [
          {
            "node": "Run weekly report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run weekly report": {
      "main": [
        [
          {
            "node": "Updates pending?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Updates pending?": {
      "main": [
        [
          {
            "node": "Discord: ask approval",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Discord: ask approval": {
      "main": [
        [
          {
            "node": "Approved?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved?": {
      "main": [
        [
          {
            "node": "Apply updates",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Discord: denied",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}